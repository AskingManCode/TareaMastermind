import "./Mensajes.lucia";
import "./Color.lucia";
import "./GeneradorCodigo.lucia";
import "./Dificultad.lucia";

class Juego {

    let mensajes: Mensajes = Mensajes();
     let generadorCodigo: GeneradorCodigo = GeneradorCodigo();
     let nivelDificultad: int = NORMAL;

    func leerPropuesta(): list<Color> {
    while (true) {
    
        // Solicita al usuario que ingrese una nueva propuesta.
        this.mensajes.mostrarSolicitudPropuesta();

        // Lee la entrada, elimina espacios y separa los colores por comas.
        let entrada: string = input("> ").trim();
        let partes: list<string> = entrada.split(",");
        let propuesta: list<Color> = [];

        // Verifica que la propuesta sea de 4 colores
        if (len(partes) != 4) {
            this.mensajes.mostrarErrorPropuesta(
                "debe ingresar exactamente cuatro colores."
            );

            continue;
        }

        let valida: bool = true;

        // Recorre cada color ingresado para comprobar que esté permitido.
        for (let i: int = 0; i < len(partes); i++) {
            let nombre: string = partes[i].trim().capitalize();
            let color: Color = Color(nombre);      //convierte el nombre ingresado a tipo color

            // Comprueba si el color pertenece a los colores permitidos
            if  (!color.esColorValido()) {
                this.mensajes.mostrarErrorPropuesta(
                    "el color ${nombre} no está permitido."
                );

                valida = false;
            } else {
                propuesta.append(color);  // Agrega el color a la propuesta cuando es válido.
            }
        }
        //si todos los colores fueron validos devuelve propuesta
        if (valida) {
            return propuesta;
        }
    }
 }


 func seleccionarDificultad(): void {
    while (true) {
        this.mensajes.mostrarMenuDificultad();

        let opcion: string = input("> ").trim();

        if (opcion == "1") {
            this.nivelDificultad = NORMAL;
            this.generadorCodigo.setNivelDificultad(NORMAL);

            this.mensajes.mostrarResultadoDificultad(
                "Dificultad seleccionada: Normal."
            );

            return;
        }

        if (opcion == "2") {
            this.nivelDificultad = ALTA;
            this.generadorCodigo.setNivelDificultad(ALTA);

            this.mensajes.mostrarResultadoDificultad(
                "Dificultad seleccionada: Alta."
            );

            return;
        }

        this.mensajes.mostrarResultadoDificultad(
            "Opción inválida. Ingrese 1 o 2."
        );
    }
 }
 
}