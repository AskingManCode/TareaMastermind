import "./Dificultad.lucia";

class Mensajes {

    func mensajeBienvenida(): void {
    
        print("");
        print("=============================");
        print(">> Bienvenido a Mastermind <<");
        print("=============================");
        print("¿Desea jugar?");
        print("[1] Continuar");
        print("[2] Salir");
    }

    func mensajeMalImput(): void {

        print("");
        print("Opción no válida, intente nuevamente.");
    }

    func preguntarVerInstrucciones(): void {
    
        print("");
        print("¿Desea ver las instrucciones del juego?");
        print("[1] Sí");
        print("[2] No");
        // Opción para volver al menú principal
        print("[3] Volver");
    }

    func mostrarInstrucciones(): void {

        print("");
        print("=================== INSTRUCCIONES ===================");
        print("El objetivo es descifrar un código secreto de 4 posiciones.");
        print("Los colores permitidos son: Amarillo, Rojo, Verde, Azul, Morado, Negro y Blanco.");
        print("");
        print("DIFICULTAD Y REGLAS:");
        print("* Nivel Normal: No se repiten colores y no hay espacios vacíos.");
        print("* Nivel Alto:  Se pueden repetir colores y se permiten posiciones vacías.");
        print("               (Indique un vacío dejando el espacio entre comas, ej: Rojo,,Azul,Verde).");
        print("");
        print("EVALUACIÓN Y PISTAS:");
        print("* Ficha Negra: Indica que acertó el color y la posición exacta.");
        print("* Ficha Blanca: Indica que acertó el color, pero está en la posición incorrecta.");
        print("");
        print("NAVEGACIÓN Y ABANDONO:");
        print("* Durante la configuración puede seleccionar [3] Volver para regresar al paso anterior.");
        print("* En la cantidad de intentos puede escribir 'Volver' para regresar al paso anterior.");
        print("* Puede ingresar la palabra 'Salir' durante la lectura de su propuesta para abandonar la partida.");
        print("");
        print("Ganas si obtienes 4 fichas negras antes de agotar sus intentos.");
        print("====================================================");
    }

    func mostrarSolicitudPropuesta(dificultad: int): void {
        
        print("");
        print("---------------------------------------------------");
        print("Ingrese cuatro posiciones separadas por comas (o escriba 'Salir' para abandonar):");
        print("Colores: Amarillo, Rojo, Verde, Azul, Morado, Negro y Blanco.");
        
        if (dificultad == ALTA) {
        
            print("En nivel Alto puede dejar posiciones vacías (ej. Rojo,,Verde,Negro).");

        } else {

            print("Ejemplo: Rojo,Azul,Verde,Amarillo.");
        }

        print("---------------------------------------------------");
    }


    func mostrarMensajeAbandono(): void {
    
        print("");
        print("---------------------------------------------------");
        print("Ha abandonado la partida actual. Regresando al menú principal...");
        print("---------------------------------------------------");
    }

    // HU-09: mensaje mostrado al volver al menú principal
    // desde cualquier punto de la configuración
    func mensajeVolverAlMenu(): void {

        print("");
        print("Volviendo al menú principal...");
    }

    func mostrarErrorPropuesta(error: string): void {

        print("");
        print("Propuesta inválida: ${error}");
    }

    func mostrarMenuDificultad(): void {
    
        print("");
        print("Seleccione la dificultad:");
        print("[1] Normal");
        print("[2] Alta");
        // HU-09: opción para volver al paso anterior
        print("[3] Volver");
    }

    func mostrarResultadoDificultad(mensaje: string): void {
    
        print(mensaje);
    }

    func mostrarMenuIntentos(): void {
    
        print("");
        print("Ingrese la cantidad de intentos para la partida (1-15):");
        // HU-09: permite regresar al paso anterior desde esta configuración
        print("(Presione Enter para usar 15, o escriba 'Volver' para regresar)");
    }

    func mostrarResultadoIntentos(mensaje: string): void {
    
        print(mensaje);
    }

    func mostrarIntentosRestantes(cantidad: int): void {
    
        print("Intentos restantes: ${cantidad}.");
        print("");
    }

    func mensajeGameOver(gano: bool): void {
    
        print("");
        print("=============================");

        if (gano) {
        
            print("Felicidades, adivinaste la combinación secreta.");
            print("¡Has ganado el juego!");

        } else {
        
            print("Se ha quedado sin intentos. ¡Ha perdido!");
        }

        print("=============================");
        print("");
    }

    func mostrarFeedback(posicionesCorrectas: int, coloresCorrectos: int): void {
        
        print("");
        print(">> Resultado del intento:");
        print("   Fichas Negras: ${posicionesCorrectas} | Fichas Blancas: ${coloresCorrectos}");
    }
}