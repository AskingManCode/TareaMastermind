class Mensajes {

    func mostrarSolicitudPropuesta(): void {
        print("Ingrese cuatro colores separados por comas.");
        print("Colores: Amarillo, Rojo, Verde, Azul, Morado y Negro.");
        print("Ejemplo: Rojo, Azul, Verde, Amarillo.");
        print("");
    }

    func mostrarErrorPropuesta(error: string): void {
        print("Propuesta inválida: ${error}");
    }

    func mostrarMenuDificultad(): void {
        print("");
        print("Seleccione la dificultad:");
        print("1. Normal");
        print("2. Alta");
    }

    func mostrarResultadoDificultad(mensaje: string): void {
        print(mensaje);
    }

    func mostrarMenuIntentos(): void {
        print("");
        print("Ingrese la cantidad de intentos para la partida.");
        print("Debe ser un número entre 1 y 15.");
    }

    func mostrarResultadoIntentos(mensaje: string): void {
        print(mensaje);
    }

    func mostrarIntentosRestantes(cantidad: int): void {
        print("Intentos restantes: ${cantidad}.");
    }
}